# Local development can proxy /wp-json to the remote WordPress origin.
# For production, override with the live wp-json endpoint.
VITE_WP_REST_URL=/wp-json

# Optional WordPress app password credentials for protected REST API routes.
# DO NOT commit your application password into source control.
VITE_WP_REST_USER=your-wp-user
VITE_WP_REST_PASSWORD=your-application-password

# Canonical public domain used in meta tags / checkout redirects / admin-ajax
VITE_SITE_URL=https://florencedolls.co.uk
