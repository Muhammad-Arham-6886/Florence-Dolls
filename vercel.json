{
  "build": {
    "env": {
      "VITE_WP_REST_URL": "/wp-json"
    }
  },
  "rewrites": [
    { "source": "/wp-json/:path*", "destination": "/api/:path*" },
    { "source": "/wp-comments-post.php", "destination": "/api/wp-comments-post" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
